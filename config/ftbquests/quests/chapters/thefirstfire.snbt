	quests: [
		{
			description: [
				"You woke four and a half thousand years late into a world that finished without you."
				"Nine civilisations left their knowledge lying around in pieces. None of it was left for you."
				"First, survive the week. The reading comes after."
			]
			icon: "minecraft:campfire"
			id: "223503805E7BCDB0"
