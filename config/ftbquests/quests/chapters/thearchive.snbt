	quests: [
		{
			description: [
				"The history of the world before the Sinborn was written in folios, and the folios were not kept together. They are in chests, in ruins, in the hands of the things that were sealed."
				"Every folio you pick up opens a page here. Every shelf you finish snaps shut with a sound."
				"Six shelves. You will not find them in order. That is the point."
			]
			icon: "minecraft:bookshelf"
			id: "5C9527F81FD9E408"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Somebody wrote it all down. Then somebody scattered it."
			tasks: [{
				id: "36FE6B9D6E6D7582"
				title: "Read"
				type: "checkmark"
			}]
			title: "The Scattered Archive"
			x: 0.0d
			y: 0.0d
		}
