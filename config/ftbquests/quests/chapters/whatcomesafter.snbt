			shape: "gear"
			size: 2.2d
			subtitle: "The God of Balance."
			tasks: [{
				id: "140A5121E9DF6D6B"
				title: "Hold it"
				type: "checkmark"
			}]
			title: "Keeper of the Seals"
			x: 0.0d
			y: 32.0d
		}
		{
			description: [
				"You read the Apocrypha and you closed it."
				""
				"Nobody is coming to ask why. There is no ledger for this and no punishment,"
				"because the only being who could impose one is the thing you declined to become."
			]
			icon: "minecraft:bread"
