	quests: [
		{
			dependencies: ["286E6E8AC3EC9136"]
			description: [
				"The archive stops here. Nine civilisations wrote down how they ended and not one of them"
				"wrote down what to do afterwards, because not one of them got this far."
				""
				"You are the first reader to reach the last page and find it blank."
			]
			icon: "ends_delight:roasted_dragon_steak"
			id: "1467F926E9E10DE0"
			shape: "octagon"
			size: 1.8d
			subtitle: "The dragon is dead. You are not."
			tasks: [{
				id: "6DD7143CE869AE0C"
				title: "Read"
				type: "checkmark"
			}]
			title: "What Comes After"
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"It was going to rot otherwise."
				"The Convent's anatomists dissected it. The Cathedral's priests worshipped it."
				"Nobody, in six thousand years of record, thought to cook it."
				""
				"This is the oldest thing a person does to a thing that tried to kill them."
			]
			icon: "ends_delight:roasted_dragon_steak"
			id: "24F62B7B528131DA"
			rewards: [{
				count: 64
				id: "3646E8EF8B55E3E3"
